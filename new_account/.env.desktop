# Build used for the packaged Tauri desktop app (Pallegama POS).
# Relative asset base ("." -> "./") so the bundled files load correctly from
# wherever Tauri serves them locally, and the live backend so the installed
# app talks to the real server, not this dev machine's localhost.
VITE_APP_BASE_PATH=.
VITE_API_BASE_URL=https://pos.dio.lk/pallegama_supermarket/backend/public
